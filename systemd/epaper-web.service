[Unit]
Description=Panel web del dashboard e-paper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_DIR__
Environment=EPAPER_BACKEND=waveshare
Environment=PYTHONUNBUFFERED=1
ExecStart=__REPO_DIR__/.venv/bin/uvicorn epaper.web.app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target
