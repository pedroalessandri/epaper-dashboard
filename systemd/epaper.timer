[Unit]
Description=Refrescar el dashboard e-paper cada 5 minutos

[Timer]
OnCalendar=*:0/5
# Si la Pi estuvo apagada, correr apenas vuelva en vez de esperar al próximo.
Persistent=true
# Evita que varias units arranquen exactamente en el mismo segundo.
RandomizedDelaySec=30
Unit=epaper.service

[Install]
WantedBy=timers.target
